<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/main_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/tvCopyright"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- LOGO E NOME DO APP -->
            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="32dp"
                android:contentDescription="@string/app_name"
                android:src="@mipmap/ic_truco" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:text="@string/app_name"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- CARD DA EQUIPE 1 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:strokeColor="@android:color/darker_gray"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvEquipe1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:text="@string/equipe1" />

                    <TextView
                        android:id="@+id/tvPontosEquipe1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:text="0"
                        android:textSize="48sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btEquipe1Mais1"
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:padding="0dp"
                            android:text="+1" />

                        <Button
                            android:id="@+id/btEquipe1Mais3"
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:padding="0dp"
                            android:text="+3" />

                        <Button
                            android:id="@+id/btEquipe1Mais6"
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:padding="0dp"
                            android:text="+6" />

                        <Button
                            android:id="@+id/btEquipe1Mais9"
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:padding="0dp"
                            android:text="+9" />

                        <Button
                            android:id="@+id/btEquipe1Mais12"
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:padding="0dp"
                            android:text="+12" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- CARD DA EQUIPE 2 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:strokeColor="@android:color/darker_gray"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvEquipe2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:text="@string/equipe2" />

                    <TextView
                        android:id="@+id/tvPontosEquipe2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:text="0"
                        android:textSize="48sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btEquipe2Mais1"
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:padding="0dp"
                            android:text="+1" />

                        <Button
                            android:id="@+id/btEquipe2Mais3"
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:padding="0dp"
                            android:text="+3" />

                        <Button
                            android:id="@+id/btEquipe2Mais6"
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:padding="0dp"
                            android:text="+6" />

                        <Button
                            android:id="@+id/btEquipe2Mais9"
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:padding="0dp"
                            android:text="+9" />

                        <Button
                            android:id="@+id/btEquipe2Mais12"
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:padding="0dp"
                            android:text="+12" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- BOTÕES DE AÇÃO -->
            <Button
                android:id="@+id/btHistorico"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/historico" />

            <Button
                android:id="@+id/btInformarNomes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/inf_nomes" />

            <Button
                android:id="@+id/btZerarHistorico"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/zerar_hist_rico"
                android:textColor="@android:color/holo_red_dark" />

        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/tvCopyright"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="120dp"
        android:padding="8dp"
        android:text="@string/copyright"
        android:textSize="12sp"
        android:textColor="?android:attr/textColorSecondary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>